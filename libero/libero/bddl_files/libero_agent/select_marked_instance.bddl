(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick up the instance with one square mark and place it in the collection bin.)
  (:regions
    (top_item_slot (:target main_table) (:ranges ((-0.245 0.085 -0.155 0.165))))
    (middle_item_slot (:target main_table) (:ranges ((-0.045 0.085 0.045 0.165))))
    (bottom_item_slot (:target main_table) (:ranges ((0.155 0.085 0.245 0.165))))
    (bin_init_region (:target main_table) (:ranges ((0.035 -0.165 0.125 -0.075))))
    (contain_region (:target perception_bin_1))
  )
  (:fixtures
    main_table - table
  )
  (:objects
    single_marked_1 - vlabench_perception_single_marked_instance
    double_marked_1 - vlabench_perception_double_marked_instance
    unmarked_1 - vlabench_perception_unmarked_instance
    perception_bin_1 - vlabench_perception_bin
  )
  (:obj_of_interest single_marked_1 double_marked_1 unmarked_1 perception_bin_1)
  (:init
    (On single_marked_1 main_table_top_item_slot)
    (On double_marked_1 main_table_middle_item_slot)
    (On unmarked_1 main_table_bottom_item_slot)
    (On perception_bin_1 main_table_bin_init_region)
  )
  (:goal
    (And (In single_marked_1 perception_bin_1_contain_region))
  )
)
