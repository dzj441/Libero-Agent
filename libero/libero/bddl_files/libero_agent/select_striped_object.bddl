(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick up the object with the striped texture and place it in the collection bin.)
  (:regions
    (top_item_slot (:target main_table) (:ranges ((-0.245 0.085 -0.155 0.165))))
    (middle_item_slot (:target main_table) (:ranges ((-0.045 0.085 0.045 0.165))))
    (bottom_item_slot (:target main_table) (:ranges ((0.155 0.085 0.245 0.165))))
    (bin_init_region (:target main_table) (:ranges ((0.035 -0.165 0.125 -0.075))))
    (contain_region (:target perception_bin_1))
  )
  (:fixtures
    main_table - table
  )
  (:objects
    striped_object_1 - vlabench_perception_striped_texture
    spotted_object_1 - vlabench_perception_spotted_texture
    plain_object_1 - vlabench_perception_plain_texture
    perception_bin_1 - vlabench_perception_bin
  )
  (:obj_of_interest striped_object_1 spotted_object_1 plain_object_1 perception_bin_1)
  (:init
    (On striped_object_1 main_table_top_item_slot)
    (On spotted_object_1 main_table_middle_item_slot)
    (On plain_object_1 main_table_bottom_item_slot)
    (On perception_bin_1 main_table_bin_init_region)
  )
  (:goal
    (And (In striped_object_1 perception_bin_1_contain_region))
  )
)
