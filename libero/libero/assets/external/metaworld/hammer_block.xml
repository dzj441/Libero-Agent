<mujoco model="metaworld_hammer_block">
  <!-- Geometry and mechanism adapted from Farama Meta-World (MIT). -->
  <asset>
    <mesh name="hammer_block_mesh" file="meshes/hammer/hammerblock.stl"/>
    <mesh name="hammer_nail_mesh" file="meshes/hammer/nail.stl"/>
    <material name="block_wood" rgba="0.54 0.30 0.12 1" shininess="0.15"/>
    <material name="nail_metal" rgba="0.64 0.66 0.70 1" shininess="0.8" specular="0.7"/>
  </asset>
  <worldbody>
    <body>
      <body name="object">
        <geom name="block_visual" type="mesh" mesh="hammer_block_mesh" pos="0 0 0.15"
              material="block_wood" contype="0" conaffinity="0" group="1"/>
        <geom name="block_collision_lower" type="box" pos="0 0 0.088" size="0.10 0.10 0.048"
              mass="10" friction="1 0.3 0.1" group="0" rgba="0.3 0.3 1 0.20"/>
        <geom name="block_collision_upper" type="box" pos="0 0 0.212" size="0.10 0.10 0.048"
              mass="10" friction="1 0.3 0.1" group="0" rgba="0.3 0.3 1 0.20"/>
        <geom name="block_collision_left" type="box" pos="-0.058 0 0.15" size="0.042 0.10 0.014"
              mass="4" friction="1 0.3 0.1" group="0" rgba="0.3 0.3 1 0.20"/>
        <geom name="block_collision_right" type="box" pos="0.058 0 0.15" size="0.042 0.10 0.014"
              mass="4" friction="1 0.3 0.1" group="0" rgba="0.3 0.3 1 0.20"/>
        <body name="nail_link" pos="0 -0.21 0.15">
          <joint name="nail_slide" type="slide" axis="0 1 0" range="0 0.10"
                 limited="true" damping="0.35" frictionloss="0.12"/>
          <geom name="nail_visual" type="mesh" mesh="hammer_nail_mesh" euler="1.5707963 0 0"
                pos="0 0.057 0" material="nail_metal" contype="0" conaffinity="0" group="1"/>
          <geom name="nail_shaft_collision" type="cylinder" euler="1.5707963 0 0"
                pos="0 0.057 0" size="0.010 0.060" mass="0.08" friction="0.8 0.2 0.1"
                group="0" rgba="0.3 0.3 1 0.25"/>
          <geom name="nail_head_collision" type="cylinder" euler="1.5707963 0 0"
                size="0.030 0.009" mass="0.04" friction="0.8 0.2 0.1" group="0"
                rgba="0.3 0.3 1 0.25"/>
          <site name="nail_head_site" pos="0 -0.010 0" size="0.004" rgba="0 0 0 0"/>
          <!-- Follow the sliding nail so the broad terminal diagnostic stays
               aligned after the nail has been driven. -->
          <site name="hammer_goal_region" type="box" pos="-0.160 -0.010 0"
                quat="1 0 0 0" size="0.035 0.045 0.045"
                rgba="0 0 0 0" group="3"/>
        </body>
      </body>
      <site name="bottom_site" pos="0 0 0" size="0.005" rgba="0 0 0 0"/>
      <site name="top_site" pos="0 0 0.260" size="0.005" rgba="0 0 0 0"/>
      <site name="horizontal_radius_site" pos="0.10 0.28 0" size="0.005" rgba="0 0 0 0"/>
    </body>
  </worldbody>
</mujoco>
