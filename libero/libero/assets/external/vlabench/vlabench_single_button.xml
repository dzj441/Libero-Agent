<?xml version="1.0" encoding="UTF-8"?>
<!-- Clean-room LIBERO support fixture for the VLABench-style Button entity.
     This mechanical control task intentionally contains no candidate object
     or alternative button: only the real touch target remains. -->
<mujoco model="libero_vlabench_single_button">
  <compiler angle="radian"/>
  <worldbody>
    <body>
      <body name="object">
        <geom name="button_pedestal" type="cylinder" size="0.034 0.042"
              pos="0 0 0.048" mass="0.03" group="1"
              rgba="0.12 0.12 0.12 1"/>
        <geom name="button_cap" type="cylinder" size="0.032 0.010"
              pos="0 0 0.085" mass="0.01" group="1"
              rgba="0.85 0.12 0.12 1" solref="0.002 1"/>
        <geom name="button_base" type="cylinder" size="0.038 0.006"
              pos="0 0 0.006" mass="0.03" group="1"
              rgba="0.12 0.12 0.12 1"/>
        <site name="button_touch_site" type="cylinder" size="0.032 0.010"
              pos="0 0 0.085" rgba="0 1 0 0"/>
        <site name="button_default_site" pos="0 0 0.085" size="0.005"
              rgba="1 0 0 0"/>
      </body>
    </body>
  </worldbody>
  <sensor>
    <touch name="button_touch" site="button_touch_site"/>
  </sensor>
</mujoco>
